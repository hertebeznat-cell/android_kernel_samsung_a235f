# Evolution X fragment for the Galaxy A23 4G, applied after a23_eur_open_defconfig
# (BoardConfig: TARGET_KERNEL_CONFIG := a23_eur_open_defconfig a23_evo.config).
# Everything Android needs (FAKE_UNAME_5_10, BPF backports, USERFAULTFD,
# BINDERFS, PSI, inline encryption) is already enabled by the base defconfig.
CONFIG_LOCALVERSION="-a23-evox"

# KernelSU stays as in the proven release config: SUSFS (fs/Kconfig) does not
# depend on KSU but calls into it, so KSU=n alone breaks the build. Without
# its manager app KernelSU grants nothing.

# Keep evidence of failed boots.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y

# Performance: drop always-on vendor debug tracing that the release build
# keeps for Samsung/Qualcomm crash analysis. pstore/ikconfig above still
# keep evidence of failed boots.
# Samsung logs every context switch and IRQ into a per-CPU ring buffer.
# CONFIG_SEC_DEBUG_SCHED_LOG is not set
# Qualcomm's register trace buffer logs every readl/writel of some drivers;
# its perf defconfigs leave it off.
# CONFIG_QCOM_RTB is not set
# Scheduler statistics updated on every enqueue/dequeue.
# CONFIG_SCHEDSTATS is not set
